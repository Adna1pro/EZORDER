<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Only INTERNET is requested in Phase 0, for future image loading and
      the (simulated) network-feel of the app. Location permissions are
      deliberately NOT declared here yet — those belong to Phase 3
      (Location screen) per the build-order spec, and Google Maps/Places
      permissions belong to Phase 8.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".EZOrderApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.EZOrder">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EZOrder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
